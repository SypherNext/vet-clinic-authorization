# Copy this file to .env to change a setting. Every value here is the default,
# so the app also runs without a .env file.

# Where the web server listens. Keep 127.0.0.1 so only your computer can connect.
PORT=18900
HOST=127.0.0.1
# The address you open in the browser.
APP_ORIGIN=http://localhost:18900

# The SQLite database file. npm run seed deletes and re-creates it.
DATABASE_FILE=data/vet-clinic.db

# Only send cookies over HTTPS. Always on when NODE_ENV=production.
COOKIE_SECURE=false
