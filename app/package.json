{
  "name": "vet-clinic-authorization",
  "version": "1.0.0",
  "private": true,
  "description": "Maple Vet Network portal: roles, ownership, sharing, token scopes, attribute and relationship rules, multi-tenancy and an audit log",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "permissions": "node scripts/permission-table.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
